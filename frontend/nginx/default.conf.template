# NexusCloud Orchestra — static SPA server config.
# Root serves the built assets; unknown paths fall back to index.html so
# client-side routes (/app/files, /app/settings, …) work on hard reload.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Security headers + CSP. nginx drops server-level add_header in any location
  # with its own add_header, so every such location re-includes this file.
  include /etc/nginx/conf.d/snippets/security-headers.conf;

  # Hashed assets are immutable.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    include /etc/nginx/conf.d/snippets/security-headers.conf;
    try_files $uri =404;
  }

  # Unauthenticated health probe.
  location = /health {
    access_log off;
    return 200 'ok';
    add_header Content-Type "text/plain" always;
    include /etc/nginx/conf.d/snippets/security-headers.conf;
  }

  # Root is the static parallax landing page (public/landing); skip loading the SPA bundle.
  location = / {
    return 302 /landing/index.html;
  }

  # Landing page and its 270 animation frames.
  location /landing/ {
    add_header Cache-Control "public, max-age=86400";
    include /etc/nginx/conf.d/snippets/security-headers.conf;
    try_files $uri =404;
  }

  # SPA fallback: every unknown path renders the app shell.
  location / {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    include /etc/nginx/conf.d/snippets/security-headers.conf;
    try_files $uri $uri/ /index.html;
  }
}
